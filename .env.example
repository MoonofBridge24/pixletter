# =====================================================
# Cloudflare（Day 1 で設定）
# =====================================================
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=

# =====================================================
# API URL（Day 2 で設定）
# =====================================================
# 開発時: http://localhost:8787
# 本番時: 空欄（_pages.dev と同一オリジン。VITE_API_URL は設定しない）
# 注意: この API_URL は Chrome 拡張の設定用。ダッシュボードは相対パスで API を呼ぶ。
API_URL=http://localhost:8787

# =====================================================
# 認証（Day 5 で設定、Phase 2）
# =====================================================
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# =====================================================
# 通知（optional）
# 全ユーザー共通のフォールバック。個別設定は Chrome 拡張から送信した SendKey が優先。
# =====================================================
SERVERCHAN_SENDKEY=

# =====================================================
# レート制限 / 防誤触（optional）
# 未設定ならデフォルト: 新規アカウント24h上限=100通、既読無視猶予=10000ms(10秒)
# TRACKING_TTL_DAYS: 送信から何日で追跡を自動停止するか（デフォルト 7 日）
# =====================================================
NEW_USER_EMAIL_LIMIT=100
OPEN_GRACE_MS=10000
TRACKING_TTL_DAYS=7

# =====================================================
# 観測性（Day 6 で設定）
# =====================================================
SENTRY_DSN=
